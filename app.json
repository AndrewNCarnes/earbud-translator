{
  "expo": {
    "name": "airpod-translator",
    "slug": "airpod-translator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andrewcarnes.airpodtranslator",
      "deploymentTarget": "26.0",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Listens to nearby speech so it can be translated.",
        "NSSpeechRecognitionUsageDescription": "Transcribes speech on-device so it can be translated.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-build-properties"
    ]
  }
}
